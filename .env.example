# Payload. Локально база — Postgres из docker-compose.yml (`docker compose up -d`), порт 5436.
DATABASE_URI=postgres://miniapps:miniapps@127.0.0.1:5436/miniapps
# Ключ подписи сессий админки: локально любая строка, на сервере — `openssl rand -hex 32`.
PAYLOAD_SECRET=

# Значения живут только в секретах хостинга, в репозитории — одни имена.
# TELEGRAM_BOT_TOKEN      — токен бота Telegram: подпись initData, сообщения клиентам и владельцу
# MAX_BOT_TOKEN           — токен бота MAX: подпись initData, сообщения клиентам
# OWNER_TELEGRAM_CHAT_ID  — чат владельца в Telegram: уведомления о новых записях
# CRM_WEBHOOK_URL         — вебхук CRM; пусто = вебхук не шлется
# TELEGRAM_API_BASE       — база Telegram Bot API; пусто = https://api.telegram.org
# MAX_API_BASE            — база MAX Bot API; пусто = https://platform-api.max.ru
