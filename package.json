{
  "name": "mrshkn-miniapps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "yarn@4.9.4",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run src/seed.ts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "yarn typecheck && yarn lint && yarn test:unit && yarn test:integration && yarn test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@telegram-apps/sdk": "3.11.8",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.5.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.1",
    "pg": "8.20.0",
    "prettier": "^3.6.0",
    "sass": "^1.93.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
